# CacheMind configuration. Copy to `.env` and adjust; `.env` is git-ignored.
# No credentials are needed for the local development profile.

# Where generated data, lakehouse layers and checkpoints live (default: <repo>/data)
# CACHEMIND_DATA_DIR=/absolute/path/to/data

# Where models/experiment outputs are written (defaults: <repo>/artifacts, <repo>/reports)
# CACHEMIND_ARTIFACTS_DIR=
# CACHEMIND_REPORTS_DIR=

# JVM used by Spark/Kafka/HBase. Default: the project-local Temurin 17 in .tools/
# JAVA_HOME=

# Spark (memory-conscious defaults for an 8 GB laptop)
CACHEMIND_SPARK_MASTER=local[2]
CACHEMIND_SPARK_DRIVER_MEMORY=1g
CACHEMIND_SPARK_SHUFFLE_PARTITIONS=4

# Kafka (bound to localhost only)
CACHEMIND_KAFKA_BOOTSTRAP=127.0.0.1:9092
CACHEMIND_KAFKA_TOPIC=cachemind.requests.v1
CACHEMIND_KAFKA_HEAP=384m

# HBase REST gateway (bound to localhost only)
CACHEMIND_HBASE_REST_URL=http://127.0.0.1:8080
CACHEMIND_HBASE_HEAP=512m
CACHEMIND_HBASE_REST_HEAP=192m

# Refuse to start JVM services when free memory is below this percentage
CACHEMIND_MIN_FREE_MEMORY_PCT=20
